# Frontend environment (Vite). Copy to frontend/.env and fill in, then rebuild.

# Google OAuth client id for sign-in. Required.
# MUST match the backend's GOOGLE_CLIENT_ID. If empty, Google sign-in is disabled.
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Note: the app calls the API at the relative path "/api" (no URL var needed) —
# serve the built frontend behind a proxy that routes /api/* to the backend.
