# Frontend environment (Vite). Optional — copy to frontend/.env only if needed.

# The app normally fetches the Google client id from the backend at runtime
# (GET /api/config, driven by the server's GOOGLE_CLIENT_ID), so you usually do
# NOT need to set anything here. This is only a build-time fallback for running
# the frontend without a backend (pure `npm run dev`); if set, it must match the
# backend's GOOGLE_CLIENT_ID.
# VITE_GOOGLE_CLIENT_ID=your-google-client-id

# The app calls the API at the relative path "/api" (no URL var needed).
