# ── Data source ──
DATA_SOURCE=bigquery

# ── BigQuery source (TWO tables: pricing + competitor) ──
BQ_PROJECT_ID=your-gcp-project-id
BQ_DATASET=your_dataset
BQ_TABLE=pricing_index_analysis
BQ_COMPETITOR_TABLE=competitor_products_analysis
BQ_LOCATION=EU
# Service-account key with read + tables.get on BOTH tables (or workload identity)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Auth ──
# Required in production. If unset, the API runs OPEN (dev mode only).
# Must match the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-google-client-id

# ── Web ──
CORS_ORIGINS=["http://localhost:5174"]
CACHE_TTL_SECONDS=900

# ── Cache (point at a writable, persistent volume in production) ──
USE_PARQUET_CACHE=true
USE_DUCKDB=true
DUCKDB_PARQUET_PATH=cache/pricing_data/fp_grain.parquet
COMPETITOR_PARQUET_PATH=cache/pricing_data/competitor_grain.parquet

# ── Background refresh (hourly smart check across both tables) ──
AUTO_REFRESH_ENABLED=true
REFRESH_INTERVAL_SECONDS=3600

# ── Frontend (set in frontend/.env at build time, not here) ──
# VITE_GOOGLE_CLIENT_ID=your-google-client-id   # must match GOOGLE_CLIENT_ID
